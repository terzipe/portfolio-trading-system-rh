# Robinhood credentials
RH_USERNAME=your_robinhood_email@example.com
RH_PASSWORD=your_robinhood_password

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Trading parameters
ACCOUNT_BUDGET=66000                # total capital to deploy
MAX_POSITION_PCT=0.20               # max single position as fraction of budget
MIN_DTE=45                          # minimum days-to-expiry for options
MAX_DAILY_LOSS_PCT=0.05             # daily drawdown stop (5%)

# iMessage alert recipient (your own number or email registered to iMessage)
IMESSAGE_RECIPIENT=+1XXXXXXXXXX

# ── VIX Trader BOT (SRS v1.4) ────────────────────────────────────────────
# Static Alpaca API key pair (paper trading). Read by config.py for the bot's
# own alpaca-py TradingClient, and reused by .mcp.json (via ${VAR} expansion)
# to authenticate the Alpaca MCP server for interactive Claude Code sessions
# in this project -- export these into your shell (or source this file)
# before launching `claude` so the MCP server can pick them up.
ALPACA_API_KEY_ID=your_alpaca_paper_key_id
ALPACA_API_SECRET_KEY=your_alpaca_paper_secret_key

UW_API_KEY=
UW_TIER=basic
UW_HAS_WEBSOCKET=false
UW_HAS_CME_FUTURES=false

VIX_ACCOUNT=AGENTIC
VIX_SLEEVE_MAX_PCT=0.05
VIX_SVIX_MAX_PCT=0.05
VIX_MAX_CONTRACTS=5
VIX_KILL_SWITCH=false

ENABLE_VIX_AUTO_SELL=true
ENABLE_VIX_AUTO_BUY=false          # flip true only after S2 sign-off (see VIX_TRADER_BOT_BUILD_PLAN.md)
ENABLE_VIX_AUTO_ROLL=false

VIX_SPIKE_LEVEL=25
VIX_SVIX_STOP_PCT=-0.15
VIX_SVIX_MTD_STOP_PCT=-0.20
VIX_SLEEVE_DAILY_LOSS_PCT=0.02
VIX_OPTION_ROLL_PCT=0.25
VIX_OPTION_TP_PCT=0.50
VIX_OPTION_SL_PCT=-0.50
VIX_RUNAWAY_PCT=0.50

VIX_MIN_DTE=10
VIX_MAX_DTE=21
VIX_CALL_MIN_DTE=21
VIX_CALL_MAX_DTE=45

VIX_LOOP_SECONDS=900
VIX_STALE_SECONDS=900
VIX_SESSION_DEAD_COOLDOWN_SEC=900
VIX_TOKEN_REAUTH_WARN_SEC=7200
VIX_SHADOW_BOOK_MAX_AGE_SEC=3600

# Google Drive uploads — off until the service-account JSON + folder IDs exist
ENABLE_GDRIVE_UPLOAD=false
GDRIVE_SERVICE_ACCOUNT_JSON=~/.tokens/gdrive_service_account.json
GDRIVE_FOLDER_DOCS_ID=
GDRIVE_FOLDER_DAILY_ID=
GDRIVE_FOLDER_LESSONS_ID=
GDRIVE_CONVERT_HTML_TO_GDOC=true
